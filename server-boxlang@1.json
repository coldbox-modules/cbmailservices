{
    "name":"cbmailservices-boxlang@1",
    "app":{
        "serverHomeDirectory":".engine/boxlang",
        "cfengine":"boxlang@1"
    },
    "web":{
        "http":{
            "port":"60299"
        },
        "rewrites":{
            "enable":"true"
        },
        "webroot":"test-harness",
        "aliases":{
            "/moduleroot/cbmailservices":"../"
        }
    },
    "JVM":{
        "heapSize":"1024",
        "javaVersion":"openjdk21_jre",
        "args":"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8888"
    },
    "openBrowser":"false",
    "cfconfig":{
        "file":".cfconfig.json"
    },
    "env":{
        "BOXLANG_DEBUG":true
    },
    "scripts":{
        "onServerInitialInstall":"install bx-mail,bx-esapi --noSave"
    }
}